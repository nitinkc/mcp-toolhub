# ─────────────────────────────────────────────
#  MCP ToolHub – Environment Variables Template
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# OpenAI API key (used for memory / vector-store tools)
OPENAI_API_KEY=your_openai_api_key_here

# Perplexity API key (optional fallback when WEB_SEARCH_PROVIDER=perplexity)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Web search provider config (OpenAI-compatible)
# Options: openai, perplexity, or custom
WEB_SEARCH_PROVIDER=perplexity
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_MODEL=

# Name of the OpenAI vector store used for memory tools
VECTOR_STORE_NAME=MCP_ToolHub_Memories

# Notes file path (used by note-taking tools)
NOTES_FILE=notes.txt

# Member database log file path (used by add_person_to_member_database tool)
MEMBER_LOG_FILE=member_log.txt

